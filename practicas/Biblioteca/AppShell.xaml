<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Biblioteca.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Biblioteca"
    Title="Biblioteca"
    BackgroundColor="#E6C48A"
    Shell.BackgroundColor="#E6C48A"
    Shell.TitleColor="#30251C"
    Shell.ForegroundColor="#30251C"
    Shell.UnselectedColor="#65513D"
    Shell.TabBarBackgroundColor="#E6C48A"
    Shell.TabBarForegroundColor="#30251C"
    Shell.TabBarTitleColor="#30251C"
    Shell.TabBarUnselectedColor="#65513D"
    Shell.NavBarHasShadow="False">

    <TabBar>
        <ShellContent
            Title="Principal"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Alta"
            ContentTemplate="{DataTemplate local:Alta}"
            Route="Alta" />
        <ShellContent
            Title="Consulta"
            ContentTemplate="{DataTemplate local:Consulta}"
            Route="Consulta" />
    </TabBar>
</Shell>
