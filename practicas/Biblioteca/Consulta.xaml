<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Biblioteca.Consulta"
    Title="Consulta"
    BackgroundColor="#E6C48A">

  <Grid
        Padding="16"
        RowDefinitions="Auto,Auto,Auto,*"
        ColumnDefinitions="*,*,*"
        RowSpacing="12"
        ColumnSpacing="12">

    <Label
            Text="Tipo de consulta:"
            Grid.Row="0"
            Grid.ColumnSpan="3"
            FontSize="20"
            FontAttributes="Bold"
            TextColor="#30251C"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center" />

    <Grid
            Grid.Row="1"
            Grid.ColumnSpan="3"
            RowDefinitions="Auto,Auto"
            RowSpacing="6"
            HorizontalOptions="Center">

      <RadioButton
            x:Name="radioAutor"
            Content="Autor"
            GroupName="consulta"
            Grid.Row="0"
            HorizontalOptions="Start"
            TextColor="#30251C"
            CheckedChanged="TipoConsulta_CheckedChanged" />

      <RadioButton
            x:Name="radioEditorial"
            Content="Editorial"
            GroupName="consulta"
            Grid.Row="1"
            HorizontalOptions="Start"
            TextColor="#30251C"
            CheckedChanged="TipoConsulta_CheckedChanged" />

    </Grid>

    <Label
            Text="Título"
            Grid.Row="2"
            Grid.Column="0"
            FontSize="20"
            FontAttributes="Bold"
            TextColor="#30251C"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center"
            LineBreakMode="WordWrap" />

    <Label
            Text="Autor/Editorial"
            Grid.Row="2"
            Grid.Column="1"
            FontSize="20"
            FontAttributes="Bold"
            TextColor="#30251C"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center"
            LineBreakMode="WordWrap" />

    <Label
            Text="Portada"
            Grid.Row="2"
            Grid.Column="2"
            FontSize="20"
            FontAttributes="Bold"
            TextColor="#30251C"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center"
            LineBreakMode="WordWrap" />

    <ListView
            x:Name="listaTitulo"
            Grid.Row="3"
            Grid.Column="0"
            BackgroundColor="Transparent"
            SeparatorVisibility="None"
            ItemSelected="listaTitulo_ItemSelected"
            RowHeight="60">

      <ListView.ItemTemplate>
        <DataTemplate>
          <ViewCell>
            <Grid RowDefinitions="*,1">

              <Label
                    Grid.Row="0"
                    Text="{Binding Titulo}"
                    Padding="12,0"
                    TextColor="#30251C"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    LineBreakMode="TailTruncation" />

              <BoxView
                    Grid.Row="1"
                    Color="DarkGreen"
                    InputTransparent="True" />

            </Grid>
          </ViewCell>
        </DataTemplate>
      </ListView.ItemTemplate>

    </ListView>

    <ListView
            x:Name="listaAutorEditorial"
            Grid.Row="3"
            Grid.Column="1"
            BackgroundColor="Transparent"
            SeparatorVisibility="None"
            ItemSelected="listaAutorEditorial_ItemSelected"
            RowHeight="60">

      <ListView.ItemTemplate>
        <DataTemplate>
          <ViewCell>
            <Grid RowDefinitions="*,1">

              <Label
                    Grid.Row="0"
                    Text="{Binding .}"
                    Padding="12,0"
                    TextColor="#30251C"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    LineBreakMode="TailTruncation" />

              <BoxView
                    Grid.Row="1"
                    Color="DarkGreen"
                    InputTransparent="True" />

            </Grid>
          </ViewCell>
        </DataTemplate>
      </ListView.ItemTemplate>

    </ListView>

    <Border
            Grid.Row="3"
            Grid.Column="2"
            Padding="8"
            BackgroundColor="Transparent"
            Stroke="Transparent"
            StrokeThickness="1">

      <Image
                x:Name="imagenPortadaAlta"
                Aspect="AspectFit" />

    </Border>

  </Grid>
</ContentPage>
