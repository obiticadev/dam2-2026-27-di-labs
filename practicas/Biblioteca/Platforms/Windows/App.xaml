<maui:MauiWinUIApplication
    x:Class="Biblioteca.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:Biblioteca.WinUI">
  <maui:MauiWinUIApplication.Resources>
    <ResourceDictionary>

      <SolidColorBrush
            x:Key="ListViewItemBackgroundPointerOver"
            Color="#E5EADF" />

      <SolidColorBrush
            x:Key="ListViewItemBackgroundPressed"
            Color="#B8CEB9" />

      <SolidColorBrush
            x:Key="ListViewItemBackgroundSelected"
            Color="#C8DCC8" />

      <SolidColorBrush
            x:Key="ListViewItemBackgroundSelectedPointerOver"
            Color="#B8CEB9" />

      <SolidColorBrush
            x:Key="ListViewItemBackgroundSelectedPressed"
            Color="#A5BFA8" />

    </ResourceDictionary>
  </maui:MauiWinUIApplication.Resources>

</maui:MauiWinUIApplication>
