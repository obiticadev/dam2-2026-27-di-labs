<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Ej4_Tienda.Models"
             xmlns:conv="clr-namespace:Ej4_Tienda.Converters"
             x:Class="Ej4_Tienda.Pages.ConsultaLista"
             Title="Consulta de clientes en Lista"
             BackgroundColor="White">

    <!-- OJO: no poner aquí estilos implícitos de Label (TargetType="Label" sin x:Key).
         En Windows hacen que las filas del CollectionView salgan vacías. -->
    <ContentPage.Resources>
        <conv:VipTextoConverter x:Key="VipTexto" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="16">

        <!-- Filtros: cada Picker con su etiqueta encima -->
        <HorizontalStackLayout Grid.Row="0" Spacing="24" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="4" WidthRequest="220">
                <Label Text="Seleccione una ciudad" FontSize="13" TextColor="Black" />
                <Picker x:Name="pickerCiudad"
                        SelectedIndexChanged="OnFiltroCambiado" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4" WidthRequest="220">
                <Label Text="VIP/No VIP" FontSize="13" TextColor="Black" />
                <Picker x:Name="pickerVip"
                        SelectedIndexChanged="OnFiltroCambiado">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Todos</x:String>
                            <x:String>VIP</x:String>
                            <x:String>No VIP</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </VerticalStackLayout>
        </HorizontalStackLayout>

        <!-- Cabecera de la tabla (mismas columnas que las filas) -->
        <VerticalStackLayout Grid.Row="1" Spacing="6">
            <Grid ColumnDefinitions="1.4*,*,*,1.8*,1.6*,0.5*" Padding="8,0">
                <Label Grid.Column="0" Text="Apellidos" FontAttributes="Bold" TextColor="Black" />
                <Label Grid.Column="1" Text="Nombre" FontAttributes="Bold" TextColor="Black" />
                <Label Grid.Column="2" Text="Ciudad" FontAttributes="Bold" TextColor="Black" />
                <Label Grid.Column="3" Text="Correo Electrónico" FontAttributes="Bold" TextColor="Black" />
                <Label Grid.Column="4" Text="Comentarios" FontAttributes="Bold" TextColor="Black" />
                <Label Grid.Column="5" Text="VIP" FontAttributes="Bold" TextColor="Black" />
            </Grid>
            <BoxView HeightRequest="2" Color="#66AD59" />
        </VerticalStackLayout>

        <!-- Filas: un cliente por fila -->
        <CollectionView Grid.Row="2"
                        x:Name="listaClientes"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No hay clientes que coincidan con los filtros."
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       Margin="0,20" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Cliente">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="1.4*,*,*,1.8*,1.6*,0.5*" Padding="8,10">
                            <Label Grid.Column="0" Text="{Binding apellido}" TextColor="Black" />
                            <Label Grid.Column="1" Text="{Binding nombre}" TextColor="Black" />
                            <Label Grid.Column="2" Text="{Binding ciudad}" TextColor="Black" />
                            <Label Grid.Column="3" Text="{Binding correo}" TextColor="Black" />
                            <Label Grid.Column="4" Text="{Binding comentarios}" TextColor="Black" />
                            <Label Grid.Column="5" Text="{Binding vip, Converter={StaticResource VipTexto}}" TextColor="Black" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#E0E0E0" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
