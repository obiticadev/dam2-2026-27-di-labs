<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ej4_Tienda.Pages.Bienvenida">

    <ScrollView>
        <Grid
            RowDefinitions="*,40"
            ColumnDefinitions="*">
            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Grid.Row="0"
                Grid.Column="0">
                <Image
                    Source="dotnet_bot.png"
                    IsVisible="True"
                    HeightRequest="300"
                    />
                <Label
                    x:Name="NombreTienda"
                    Text="Nombre de la Tienda"
                    HorizontalTextAlignment="Center"
                    FontAttributes="Bold"
                    TextTransform="Uppercase"
                    FontSize="Title"
                    />
    
  
            </VerticalStackLayout>
            <VerticalStackLayout
                Grid.Row="1"
                Grid.Column="0"
                VerticalOptions="Center"
                HorizontalOptions="Start">
                <Label
                    Text="Hora"
                    FontSize="Default"
                    x:Name="hora"
                    Margin="20,0,0,0"
                    />
  
            </VerticalStackLayout>
        </Grid>
        
        
    </ScrollView>

</ContentPage>
