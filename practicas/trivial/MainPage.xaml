<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="trivial.MainPage"
             BackgroundImageSource="europa.jpg"
             Title="Bienvenido al juego Trivial Geográfico de Europa"
             >

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            VerticalOptions="Center"
            >
            <Label
                Text="Elige una opción del juego pulsando su botón"
                FontSize="35"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                FontFamily="Astronomy"
                TextDecorations="Underline"
                />
            <Button
                x:Name="paises"
                Text="Capitales de 10 paises"
                FontSize="40"
                FontFamily="Best Quality"
                FontAttributes="Bold"
                TextColor="Black"
                BorderWidth="2"
                BorderColor="Black"
                BackgroundColor="Transparent"
                WidthRequest="480"
                />
            <Button
                x:Name="capitales"
                Text="Paises de 10 capitales"
                FontSize="40"
                FontFamily="Best Quality"
                FontAttributes="Bold"
                TextColor="Black"
                BorderWidth="2"
                BorderColor="Black"
                BackgroundColor="Transparent"
                WidthRequest="480"
                />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
