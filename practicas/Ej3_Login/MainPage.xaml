<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Ej3_Login"
             x:Class="Ej3_Login.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            MaximumWidthRequest="500"
            MinimumWidthRequest="300">
            <Label
                Text="Register"
                FontSize="Header"
                FontFamily="Monospace"
                FontAttributes="Bold"
                HorizontalTextAlignment="End"
                Margin="0,0,50,0" />
            <Label
                Text="User"
                FontSize="Medium"
                FontFamily="Monospace" />
            <Entry
                x:Name="name"
                Placeholder="Ej: Mateo Alemán"
                ReturnType="Next" />
            <Label
                Text="Password"
                FontSize="Medium"
                FontFamily="Monospace" />
            <Entry
                x:Name="pass"
                Placeholder="Ej: Mateo123"
                IsPassword="True"
                ReturnType="Next" />
            <Button
                x:Name="login"
                Text="Login"
                BackgroundColor="GreenYellow"
                TextColor="Black"
                Clicked="Button_Clicked" />

            <Label
                Text="Usuarios Registrados"
                FontSize="Medium"
                FontAttributes="Bold"
                FontFamily="Monospace"
                Margin="0,15,0,0" />

            <!-- CollectionView virtualizado para renderizar la lista de usuarios -->
            <CollectionView
                x:Name="listaUsuarios"
                Margin="0,5,0,20"
                HeightRequest="350"
                VerticalScrollBarVisibility="Default">
                <CollectionView.EmptyView>
                    <Label
                        Text="No hay usuarios registrados todavía"
                        TextColor="Gray"
                        HorizontalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:User">
                        <Border
                            Margin="0,4"
                            Padding="12"
                            Background="#F0F0F0"
                            StrokeThickness="0">
                            <Label
                                Text="{Binding name, StringFormat='- {0}'}"
                                FontSize="16"
                                TextColor="Black" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
